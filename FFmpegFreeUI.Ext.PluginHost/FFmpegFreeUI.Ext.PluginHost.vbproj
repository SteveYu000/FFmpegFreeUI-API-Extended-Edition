<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OptionStrict>On</OptionStrict>
    <RootNamespace>FFmpegFreeUI</RootNamespace>
    <AssemblyName>FFmpegFreeUI.Ext.PluginHost</AssemblyName>
    <Version>2.5.0</Version>
    <AssemblyVersion>2.5.0.0</AssemblyVersion>
    <FileVersion>2.5.0.0</FileVersion>
    <InformationalVersion>v2.5</InformationalVersion>
    <Product>FFmpegFreeUI API Extended Edition Ext Plugin Host</Product>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\FFmpegFreeUI\功能\Ext插件扩展宿主_v2.vb" Link="Ext插件扩展宿主_v2.vb" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FFmpegFreeUI\FFmpegFreeUI.vbproj" />
    <ProjectReference Include="..\FFmpegFreeUI.Ext.PluginSdk\FFmpegFreeUI.Ext.PluginSdk.csproj" />
  </ItemGroup>

  <!-- LakeUI 5 由主程序以文件引用方式接入，不会像旧 NuGet 包那样把编译资产
       传递给引用主程序的项目；PluginHost 中包含导航页宿主实现，因此也必须显式
       引用完全相同的 LakeUI 程序集。该引用只修复构建依赖，不改变 Ext SDK ABI。 -->
  <ItemGroup>
    <Reference Include="LakeUI">
      <HintPath>..\..\LakeUI\LakeUI\bin\Debug\net10.0-windows10.0.17763.0\LakeUI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Ext PluginHost 随宿主发行但保持休眠；SDK 仍按用户是否已安装来更新。 -->
  <Target Name="CopyExtPluginHostToFFmpegFreeUIOutput" AfterTargets="Build">
    <PropertyGroup>
      <FFmpegFreeUIOutputDirectory>$(MSBuildThisFileDirectory)..\FFmpegFreeUI\bin\$(Configuration)\$(TargetFramework)\</FFmpegFreeUIOutputDirectory>
      <!-- 旧 SDK 存在表示用户此前已启用扩展 API；本次构建将其一次性迁移到 Ext 程序集。 -->
      <ExtSdkWasInstalled Condition="Exists('$(FFmpegFreeUIOutputDirectory)FFmpegFreeUI.Ext.PluginSdk.dll') Or Exists('$(FFmpegFreeUIOutputDirectory)FFmpegFreeUI.PluginSdk.dll')">true</ExtSdkWasInstalled>
    </PropertyGroup>
    <MakeDir Directories="$(FFmpegFreeUIOutputDirectory)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(FFmpegFreeUIOutputDirectory)FFmpegFreeUI.Ext.PluginHost.dll" />
    <ItemGroup>
      <BuiltExtPluginSdk Include="@(ReferenceCopyLocalPaths)"
                         Condition="'%(Filename)' == 'FFmpegFreeUI.Ext.PluginSdk' and '%(Extension)' == '.dll'" />
    </ItemGroup>
    <Copy SourceFiles="@(BuiltExtPluginSdk)"
          DestinationFiles="$(FFmpegFreeUIOutputDirectory)FFmpegFreeUI.Ext.PluginSdk.dll"
          Condition="'$(ExtSdkWasInstalled)' == 'true'" />
    <!-- 不保留无 Ext 前缀的兼容垫片，避免与官方未来程序集身份冲突。 -->
    <Delete Files="$(FFmpegFreeUIOutputDirectory)FFmpegFreeUI.PluginHost.dll;
                   $(FFmpegFreeUIOutputDirectory)FFmpegFreeUI.PluginHost.pdb;
                   $(FFmpegFreeUIOutputDirectory)FFmpegFreeUI.PluginSdk.dll;
                   $(FFmpegFreeUIOutputDirectory)FFmpegFreeUI.PluginSdk.pdb;
                   $(FFmpegFreeUIOutputDirectory)FFmpegFreeUI.PluginSdk.xml" />
  </Target>

</Project>
